# Copia este archivo a .env y ajusta los valores.

# ── Base de datos ──────────────────────────────────────────────
# Local con Docker: las dos URL son iguales.
# Neon: en Vercel → Storage → tu base → ".env.local" copia las dos.
#   DATABASE_URL          → con pooling (el host lleva "-pooler"), la usa la app
#   DATABASE_URL_UNPOOLED → directa, la usan las migraciones de Prisma
DATABASE_URL="postgresql://planta:planta@localhost:5432/planta"
DATABASE_URL_UNPOOLED="postgresql://planta:planta@localhost:5432/planta"

# ── Sesiones ───────────────────────────────────────────────────
# Genera uno con: npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# ── Solo para el despliegue en Vercel ──────────────────────────
# "true": en cada despliegue crea los 4 usuarios de prueba y los materiales (no duplica).
# SEED_ON_DEPLOY="true"
# "true": carga datos de demostración, pero solo si la base no tiene clientes todavía.
# SEED_DEMO="true"
# "true": muestra los botones de "Perfiles de prueba" en el login. Quitar para uso real.
# NEXT_PUBLIC_MOSTRAR_PERFILES_DEMO="true"
