generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  OPERADOR
  ALMACEN
  ADMIN
  GERENCIA
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum Area {
  EXTRUSION
  IMPRESION
  CONFECCION
}

enum CategoriaMaterial {
  RECICLADO
  VIRGEN
  TINTA
  MASTER_BATCH
  SOLVENTE
  OTRO
}

enum MedioPago {
  QR
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model User {
  id           String                 @id @default(cuid())
  nombre       String
  email        String                 @unique
  passwordHash String
  rol          Rol
  activo       Boolean                @default(true)
  movimientos  MovimientoInventario[]
  registros    RegistroProduccion[]
  createdAt    DateTime               @default(now())
}

model Cliente {
  id          String         @id @default(cuid())
  nombre      String
  contacto    String?
  telefono    String?
  direccion   String?
  diasCredito Int            @default(15)
  ordenes     OrdenTrabajo[]
  pagos       Pago[]
  createdAt   DateTime       @default(now())
}

model Material {
  id            String                 @id @default(cuid())
  nombre        String                 @unique
  categoria     CategoriaMaterial
  unidad        String                 @default("kg")
  stockMinimo   Decimal                @default(0) @db.Decimal(12, 2)
  costoPromedio Decimal                @default(0) @db.Decimal(12, 4)
  movimientos   MovimientoInventario[]
}

// Inmutable: las correcciones se hacen con tipo AJUSTE
model MovimientoInventario {
  id            String          @id @default(cuid())
  materialId    String
  material      Material        @relation(fields: [materialId], references: [id])
  tipo          TipoMovimiento
  cantidad      Decimal         @db.Decimal(12, 2) // AJUSTE puede ser negativo
  costoUnitario Decimal?        @db.Decimal(12, 4)
  turno         Turno
  motivo        String?
  proveedor     String?
  lote          String?
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  ordenId       String?
  orden         OrdenTrabajo?   @relation(fields: [ordenId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([materialId, createdAt])
}

model OrdenTrabajo {
  id             String                 @id @default(cuid())
  numero         Int                    @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente                @relation(fields: [clienteId], references: [id])
  fechaIngreso   DateTime               @default(now())
  producto       String
  medida         String?
  kgPedidos      Decimal                @db.Decimal(12, 2)
  precioUnitario Decimal                @db.Decimal(12, 4) // por kg
  estado         String                 @default("ABIERTA")
  mezclaNota     String?                // ej. 50 termo + 50 stretch
  registros      RegistroProduccion[]
  entregas       Entrega[]
  movimientos    MovimientoInventario[]
}

model RegistroProduccion {
  id           String       @id @default(cuid())
  ordenId      String
  orden        OrdenTrabajo @relation(fields: [ordenId], references: [id])
  area         Area
  turno        Turno
  kgEntrada    Decimal      @db.Decimal(12, 2)
  kgBuenos     Decimal      @db.Decimal(12, 2)
  kgMerma      Decimal      @db.Decimal(12, 2)
  kgRechazado  Decimal      @default(0) @db.Decimal(12, 2)
  horasMaquina Decimal?     @db.Decimal(6, 2)
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())
}

model Entrega {
  id           String       @id @default(cuid())
  ordenId      String
  orden        OrdenTrabajo @relation(fields: [ordenId], references: [id])
  notaRemision String?
  fecha        DateTime     @default(now())
  kgEntregados Decimal      @db.Decimal(12, 2)
  bultos       Int?
}

model Pago {
  id         String    @id @default(cuid())
  clienteId  String
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  ordenId    String?
  monto      Decimal   @db.Decimal(12, 2)
  fecha      DateTime  @default(now())
  medio      MedioPago @default(QR)
  referencia String?
}

model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  descripcion String?
  monto       Decimal  @db.Decimal(12, 2)
}

model CostoTurno {
  id        String   @id @default(cuid())
  fecha     DateTime
  turno     Turno
  manoObra  Decimal  @db.Decimal(12, 2)
  energia   Decimal  @db.Decimal(12, 2)

  @@unique([fecha, turno], name: "fecha_turno")
}
