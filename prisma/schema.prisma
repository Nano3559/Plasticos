generator client {
  provider   = "prisma-client-js"
  engineType = "client" // sin motor Rust: usa el adaptador de pg (ver src/lib/prisma.ts)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon con pooling: la usa la app
  directUrl = env("DATABASE_URL_UNPOOLED") // Neon directa: la usan las migraciones
}

enum Rol {
  OPERADOR
  ALMACEN
  ADMIN
  GERENCIA
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum Area {
  EXTRUSION
  IMPRESION
  CONFECCION
}

enum CategoriaMaterial {
  RECICLADO
  VIRGEN
  TINTA
  MASTER_BATCH
  SOLVENTE
  OTRO
}

enum MedioPago {
  QR
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model User {
  id           String                 @id @default(cuid())
  nombre       String
  email        String                 @unique
  passwordHash String
  rol          Rol
  activo       Boolean                @default(true)
  /// Obliga a cambiar la contraseña en el próximo ingreso (usuarios nuevos o clave restablecida)
  debeCambiarClave Boolean            @default(false)
  /// Sube cada vez que cambia la clave, el rol o el estado: cierra las sesiones abiertas
  sesionVersion    Int                @default(0)
  intentosFallidos Int                @default(0)
  bloqueadoHasta   DateTime?
  ultimoAcceso     DateTime?
  movimientos  MovimientoInventario[]
  registros    RegistroProduccion[]
  createdAt    DateTime               @default(now())
  notasCredito NotaCredito[]
  gastos       Gasto[]
  notificaciones Notificacion[]
}

model Cliente {
  id          String         @id @default(cuid())
  nombre      String
  contacto    String?
  telefono    String?
  direccion   String?
  diasCredito Int            @default(15)
  ordenes     OrdenTrabajo[]
  pagos       Pago[]
  notasCredito NotaCredito[]
  createdAt   DateTime       @default(now())
}

model Material {
  id            String                 @id @default(cuid())
  nombre        String                 @unique
  categoria     CategoriaMaterial
  unidad        String                 @default("kg")
  stockMinimo   Decimal                @default(0) @db.Decimal(12, 2)
  costoPromedio Decimal                @default(0) @db.Decimal(12, 4)
  movimientos   MovimientoInventario[]
}

// Inmutable: las correcciones se hacen con tipo AJUSTE
model MovimientoInventario {
  id            String          @id @default(cuid())
  materialId    String
  material      Material        @relation(fields: [materialId], references: [id])
  tipo          TipoMovimiento
  cantidad      Decimal         @db.Decimal(12, 2) // AJUSTE puede ser negativo
  costoUnitario Decimal?        @db.Decimal(12, 4)
  turno         Turno
  motivo        String?
  proveedor     String?
  lote          String?
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  ordenId       String?
  orden         OrdenTrabajo?   @relation(fields: [ordenId], references: [id])
  createdAt     DateTime        @default(now())
  rechazos      RegistroProduccion[] @relation("RechazoEntrada")

  @@index([materialId, createdAt])
}

model OrdenTrabajo {
  id             String                 @id @default(cuid())
  numero         Int                    @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente                @relation(fields: [clienteId], references: [id])
  fechaIngreso   DateTime               @default(now())
  producto       String
  medida         String?
  kgPedidos      Decimal                @db.Decimal(12, 2)
  precioUnitario Decimal                @db.Decimal(12, 4) // por kg
  estado         String                 @default("ABIERTA")
  mezclaNota     String?                // ej. 50 termo + 50 stretch
  origenKey      String?                @unique // clave de importación de kardex: evita duplicar al reimportar
  refExterna     String?                // N° de OT tal como figura en el Excel del cliente
  registros      RegistroProduccion[]
  entregas       Entrega[]
  notasCredito   NotaCredito[]
  movimientos    MovimientoInventario[]
}

model RegistroProduccion {
  id           String       @id @default(cuid())
  ordenId      String
  orden        OrdenTrabajo @relation(fields: [ordenId], references: [id])
  area         Area
  turno        Turno
  kgEntrada    Decimal      @db.Decimal(12, 2)
  kgBuenos     Decimal      @db.Decimal(12, 2)
  kgMerma      Decimal      @db.Decimal(12, 2)
  kgRechazado  Decimal      @default(0) @db.Decimal(12, 2)
  /// Rechazo en extrusión: de qué entrada (lote) vino el material malo, para saber qué proveedor entrega mal
  rechazoEntradaId String?
  rechazoEntrada   MovimientoInventario? @relation("RechazoEntrada", fields: [rechazoEntradaId], references: [id], onDelete: SetNull)
  rechazoProveedor String? // copiado de la entrada, o escrito a mano si el lote no estaba registrado
  rechazoLote      String?
  rechazoMotivo    String?
  rechazoNota      String?
  horasMaquina Decimal?     @db.Decimal(6, 2)
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([rechazoEntradaId])
}

model Entrega {
  id           String       @id @default(cuid())
  ordenId      String
  orden        OrdenTrabajo @relation(fields: [ordenId], references: [id])
  notaRemision String?
  fecha        DateTime     @default(now())
  kgEntregados Decimal      @db.Decimal(12, 2)
  bultos       Decimal?     @db.Decimal(8, 2) // admite medios bultos: "5 1/2"
  origenKey    String?      @unique // clave de importación de kardex

  @@index([ordenId, fecha])
}

model Pago {
  id         String    @id @default(cuid())
  clienteId  String
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  ordenId    String?
  monto      Decimal   @db.Decimal(12, 2)
  fecha      DateTime  @default(now())
  medio      MedioPago @default(QR)
  referencia String?
  origenKey  String?   @unique // clave de importación de kardex

  @@index([clienteId, fecha])
}

model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  descripcion String?
  monto       Decimal  @db.Decimal(12, 2)
  comprobante String? // N° de factura o recibo
  userId      String? // quién lo registró (opcional para gastos anteriores a este campo)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([fecha])
}

model CostoTurno {
  id        String   @id @default(cuid())
  fecha     DateTime
  turno     Turno
  manoObra  Decimal  @db.Decimal(12, 2)
  energia   Decimal  @db.Decimal(12, 2)

  @@unique([fecha, turno], name: "fecha_turno")
}

enum TipoNotaCredito {
  DEVOLUCION // el cliente devolvió producto: kg × precio de la OT
  DESCUENTO  // rebaja, bonificación o ajuste por un monto
}

/// Rebaja la deuda del cliente sin ser un pago (no entra plata). No se edita ni se borra:
/// si se registró mal, Gerencia la anula (queda en el historial) y se registra otra.
model NotaCredito {
  id           String          @id @default(cuid())
  clienteId    String
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  ordenId      String?
  orden        OrdenTrabajo?   @relation(fields: [ordenId], references: [id])
  tipo         TipoNotaCredito
  fecha        DateTime        @default(now())
  kg           Decimal?        @db.Decimal(12, 2) // solo DEVOLUCION
  monto        Decimal         @db.Decimal(12, 2) // siempre positivo: lo que se descuenta
  motivo       String
  notaRemision String?         // N.R. a la que corresponde
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  origenKey    String?         @unique // clave de importación de kardex
  createdAt    DateTime        @default(now())
  /// Anulada por Gerencia: queda en el historial pero no rebaja la deuda
  anuladaEn     DateTime?
  anuladaMotivo String?

  @@index([clienteId, fecha])
}

enum TipoNotificacion {
  SALIDA     // vale de salida de inventario
  AJUSTE     // corrección de inventario (suma o resta)
  STOCK_BAJO // una salida o ajuste dejó el material por debajo de su mínimo
  RECHAZO    // material rechazado en extrusión, con su proveedor y lote
}

/// Avisos dentro de la app. Una fila por destinatario, para que cada uno marque las suyas como leídas.
model Notificacion {
  id           String           @id @default(cuid())
  userId       String           // destinatario
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         TipoNotificacion
  titulo       String
  detalle      String?
  href         String?          // a dónde lleva al tocarla
  movimientoId String?          // movimiento de inventario que la generó
  leidaEn      DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, leidaEn, createdAt])
}
